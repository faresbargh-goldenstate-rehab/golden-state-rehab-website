# Cloudflare Pages response headers.
# HTML revalidates on each load: the browser sends a conditional request and
# gets a tiny 304 when nothing changed, or the fresh file the instant it does.
# This is the fix for "I pushed but my browser still shows the old version".
# NOTE: for the CSS/JS/image rules below to be authoritative, set the zone's
# Browser Cache TTL to "Respect Existing Headers" in the Cloudflare dashboard
# (Caching > Configuration) — otherwise the 4h zone default overrides them.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Report-only first: watch the browser console / GSC for violations for a
  # week, then rename to Content-Security-Policy to enforce.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://unpkg.com https://news.google.com https://maps.googleapis.com https://ajax.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.goldenstate-rehab.com https://www.google-analytics.com https://www.googletagmanager.com https://*.google.com https://*.gstatic.com https://*.googleapis.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://www.googletagmanager.com https://news.google.com https://maps.googleapis.com; frame-src https://www.google.com https://maps.google.com https://news.google.com; object-src 'none'; base-uri 'self'; form-action 'self'

# Versioned static assets (?v= cache-busting) are safe to cache long-term.
# The "! Cache-Control" line detaches the /* rule's value so headers don't stack.
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images use stable filenames; a month with revalidation is a safe middle.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

# Chat-widget knowledge base (data/chat-kb.*.json). Deliberately NOT under
# /js/ so it inherits the /* revalidate rule — KB edits ship on deploy with no
# ?v= bump. Keep it out of search results; it's data, not a page.
/data/*
  X-Robots-Tag: noindex, nofollow

# Internal planning docs are checked in next to the site and Cloudflare Pages
# serves the whole tree. Keep them out of the index until they are moved out of
# the deploy (see docs/seo-audit-2026-08-29/ACTION-PLAN.md, item C1).
/docs/*
  X-Robots-Tag: noindex, nofollow
/*.md
  X-Robots-Tag: noindex, nofollow
/*.docx
  X-Robots-Tag: noindex, nofollow
/*.pdf
  X-Robots-Tag: noindex, nofollow
/*.csv
  X-Robots-Tag: noindex, nofollow
